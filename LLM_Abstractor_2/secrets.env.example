# =============================================================================
# Dartmouth Vietnam Project - API Configuration
# =============================================================================
#
# Copy this file to "secrets.env" and fill in your API keys.
#
# Priority: If both keys are provided, Dartmouth Chat API will be prioritized.
# You only need ONE of these keys to run the script.
#
# =============================================================================

# -----------------------------------------------------------------------------
# Dartmouth Chat API (Prioritized if both keys are provided)
# -----------------------------------------------------------------------------
# Get your API key from: https://chat.dartmouth.edu/
# This is the recommended option for Dartmouth affiliates.

DARTMOUTH_CHAT_API_KEY=your_dartmouth_api_key_here

# Optional: Specify a different model (see available models below)
# DARTMOUTH_MODEL=anthropic.claude-3-5-haiku-20241022

# -----------------------------------------------------------------------------
# OpenAI API (Used if Dartmouth key is not provided)
# -----------------------------------------------------------------------------
# Get your API key from: https://platform.openai.com/api-keys

OPENAI_API_KEY=your_openai_api_key_here

# Optional: Specify a different model (see available models below)
# OPENAI_MODEL=gpt-4o-2024-08-06

# =============================================================================
# Available Models
# =============================================================================
#
# Dartmouth Chat API Models (RECOMMENDED - tested and working):
#   - anthropic.claude-3-5-haiku-20241022 (default, fast and efficient)
#   - anthropic.claude-3-5-sonnet-20241022
#   - anthropic.claude-3-5-sonnet-20240620
#   - anthropic.claude-3-opus-20240229
#   - openai.gpt-4o-2024-11-20
#   - openai.gpt-4o-mini-2024-07-18
#   - meta.llama-3.3-70b-instruct
#
# NOTE: Some models like "openai_responses.*" may return empty responses.
# If you get errors, try a different model from the list above.
#
# Get full model list: curl -H "Authorization: bearer YOUR_KEY" https://chat.dartmouth.edu/api/models
#
# OpenAI Models:
#   - gpt-4o-2024-08-06 (default)
#   - gpt-4o
#   - gpt-4o-mini
#   - gpt-4-turbo
#
# =============================================================================
